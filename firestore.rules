rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // POS-style owner-scoped workspace. Every record for an account lives at
    // users/{authenticated UID}/... and can only be accessed by that UID.
    function isWorkspaceOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    match /users/{ownerUid}/{document=**} {
      allow read, write: if isWorkspaceOwner(ownerUid);
    }

    // Legacy root collections are intentionally closed. Run the included
    // one-time migration script before switching an existing installation.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
